# Sitecore Content Hub Credentials
CH_BASE_URL=https://<tenant>.sitecorecontenthub.cloud
CH_CLIENT_ID=ImageUpload
CH_CLIENT_SECRET=your_client_secret
CH_USERNAME=your_username
CH_PASSWORD=your_password

# Azure Service Bus
SB_CONNECTION="Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=ContentHubAccess;SharedAccessKey=...;EntityPath=contenthub"
SB_QUEUE=contenthub

# AI Models (Fast CPU mode)
DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
SAM_MODEL=facebook/sam-vit-base
PYTHONUNBUFFERED=1
